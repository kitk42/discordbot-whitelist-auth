# 本番用の設定。VM の /etc/whitelist-bot/env にコピーして値を入れる（docs/deploy.md 参照）。
# 所有者 root:whitelist-bot、権限 0640。このファイル自体に値を書いてコミットしないこと。
DISCORD_TOKEN=
GUILD_ID=
AUTH_CHANNEL_ID=
ADMIN_CHANNEL_ID=
ADMIN_ROLE_ID=
RCON_HOST=127.0.0.1
RCON_PORT=25575
# /srv/minecraft/server.properties の rcon.password と同じ値
RCON_PASSWORD=
DATABASE_PATH=/var/lib/whitelist-bot/whitelist.db
